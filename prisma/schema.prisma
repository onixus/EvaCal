// EvaCal: labor-cost calculator
// PostgreSQL is the only database in development, tests and production.

// Prisma 7: Rust-free клиент, генерируется в репозиторий, а не в node_modules
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// RBAC: роли платформы перечислены в lib/appRoles.ts (AppRole).
model User {
  id                 String         @id @default(cuid())
  username           String         @unique
  role               String // presale | architect | techwriter | gap | reviewer | admin
  passwordHash       String
  mustChangePassword Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  harnessAgents      HarnessAgent[]
}

// Внешний «харнесс-агент» архитектора/ГИПа: HTTP-endpoint, который платформа
// вызывает в режимах ревью и обогащения комплекта ГОСТ 34. Токен хранится
// только на сервере и никогда не сериализуется клиенту.
model HarnessAgent {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  endpoint    String
  // Bearer-токен для Authorization; пустой — агент без аутентификации.
  authToken   String?
  // JSON-массив режимов: подмножество ["review","enrichment"].
  modes       String    @default("[\"review\"]")
  enabled     Boolean   @default(true)
  // Итог последнего вызова («ok» или текст ошибки) — для диагностики в UI.
  lastStatus  String?
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId])
}

// A questionnaire template built in the admin's visual form constructor.
// Every "active" template is offered to presale, who picks the product/industry
// template for each new calculation. Inactive templates are kept so old
// calculations remain readable.
model FormTemplate {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  isActive             Boolean         @default(false)
  // Optional locked default: when set, every calculation from this template
  // inherits the start date and only architect/admin can override it.
  defaultStartDate     DateTime?
  // Scheduling: length of a working day (4-6h) and whether weekends count as working days.
  workDayHours         Int             @default(6)
  includeWeekends      Boolean         @default(false)
  // Commercial defaults (Horizon B4)
  defaultCurrency      String          @default("RUB")
  defaultRoleRates     String? // JSON-encoded { [role]: hourlyRate }
  defaultMarginPercent Float           @default(20)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  fields               FormField[]
  stageTemplates       StageTemplate[]
  riskTemplates        RiskTemplate[]
  calculations         Calculation[]
  calendar             WorkCalendar?   @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarId           String? // #103 WP-5d: производственный календарь; null — календарь по умолчанию
  normProposals        NormProposal[] // #103 WP-6c

  // Presale looks up the active templates on every page load.
  @@index([isActive])
  // The admin template list pages through this ordering; id breaks createdAt ties.
  @@index([createdAt, id])
}

// A single question/field in the questionnaire.
model FormField {
  id         String       @id @default(cuid())
  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  key        String // machine key, referenced by StageTemplate.driverFieldKey and stored in Calculation.answers
  type       String // text | number | select | checkbox | textarea
  options    String? // JSON-encoded array of strings, used when type = select
  required   Boolean      @default(false)
  order      Int          @default(0)

  // Index the foreign key and ordering used by every read of this table:
  // is "all rows for one template, in display order".
  @@index([templateId, order])
}

// Defines a stage that gets generated for every calculation made from this template.
// hours = baseHours + hoursPerUnit * answers[driverFieldKey]
model StageTemplate {
  id             String       @id @default(cuid())
  templateId     String
  template       FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  role           String // consultant | developer | engineer | analyst | architect | customer | other
  baseHours      Float        @default(0)
  hoursPerUnit   Float        @default(0)
  driverFieldKey String?
  // Admin-set default "Требования и ограничения" text, copied onto every stage
  // generated from this stage template. The architect can still edit it per calculation.
  requirements   String?
  order          Int          @default(0)
  normProposals  NormProposal[] // #103 WP-6c

  @@index([templateId, order])
}

// Admin-defined default risk, copied onto every calculation made from this template
// (as a Risk row) so common risks don't need to be re-entered by hand each time.
model RiskTemplate {
  id          String       @id @default(cuid())
  templateId  String
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  description String
  hours       Float        @default(0)
  order       Int          @default(0)

  @@index([templateId, order])
}

// A business/presale project aggregating calculations and released GOST 34 document packages.
model Project {
  id          String   @id @default(cuid())
  name        String
  code        String? // Readable project code/slug (e.g., "PRJ-2026-001")
  customer    String // Customer organization name
  description String?
  status      String   @default("active") // active | on_hold | completed | archived
  createdBy   String   @default("presale")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Исход сделки (Horizon E1). Сделка одна на проект, расчётов-версий много,
  // поэтому исход живёт здесь, а факт по этапам — на выигранной версии.
  dealStatus       String    @default("open") // open | won | lost | cancelled
  dealClosedAt     DateTime?
  dealClosedBy     String?
  lossReason       String? // price | competitor | timing | no_budget | scope | relationship | other
  lossComment      String?
  competitor       String?
  contractAmount   Float? // сумма договора без НДС
  contractCurrency String?
  wonCalculationId String? // версия расчёта, по которой подписан договор
  actualsClosedAt  DateTime? // факт закрыт: этапы дальше правит только админ

  calculations Calculation[]
  packages     GostPackage[]

  @@index([createdAt, id])
  @@index([customer, status])
  @@index([dealStatus, dealClosedAt])
}

// A concrete labor-cost calculation, produced by presale, refined by the architect.
model Calculation {
  id                     String       @id @default(cuid())
  name                   String
  customer               String
  templateId             String
  template               FormTemplate @relation(fields: [templateId], references: [id])
  answers                String // JSON-encoded { [fieldKey]: value }
  status                 String       @default("draft") // draft | pending_approval | approved
  // Момент последней смены статуса: срок «на этапе» считается от него, а не
  // от updatedAt, который сбрасывает любая правка. Null — до первой смены.
  stageEnteredAt         DateTime?
  startDate              DateTime     @default(now()) // anchors the whole Gantt schedule
  // РП (project manager) allowance: 8h start + 8h close + complexity overhead.
  // Counted only in the calculation's total labor hours — never shown as a Gantt stage.
  pmHours                Float        @default(0)
  // Факт часов РП по выигранной версии (Horizon E1).
  actualPmHours          Float?
  // #103 4.5: подтверждённый остаток часов РП; null — не подтверждён.
  remainingPmHoursEstimate Float?
  remainingPmActualBaseline Float?
  remainingPmEstimatedBy   String?
  remainingPmEstimatedAt   DateTime?
  createdBy             String       @default("presale")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  // Нормативная привязка выпущенного комплекта ГОСТ 34 (PR-12). Пустые поля —
  // это проект, выпущенный до реестра профилей: он читается как
  // gost34-legacy-89 и может быть мигрирован на действующую редакцию.
  standardProfileId      String?
  standardProfileVersion String?
  generatorVersion       String?
  generatedAt            DateTime?

  // Project link and versioning (Horizon B1)
  projectId           String?
  project             Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  version             Int           @default(1)
  parentCalculationId String?
  parentCalculation   Calculation?  @relation("CalculationVersions", fields: [parentCalculationId], references: [id], onDelete: SetNull)
  derivedCalculations Calculation[] @relation("CalculationVersions")
  specifications      SpecificationVersion[]
  sizingRuns          SizingRun[]
  versionComment      String? // Version change note (e.g. "Base estimate with risk buffer")

  // Commercial financial profile (Horizon B4)
  currency        String  @default("RUB") // RUB | USD | EUR | CNY | KZT | BYN
  roleRates       String? // JSON-encoded { [role]: hourlyRate }
  overheadPercent Float   @default(0) // Overhead allowance (%)
  pricingMode     String  @default("legacy_markup") // legacy_markup | markup | target_margin
  marginPercent   Float   @default(20) // Percent in the explicitly selected pricing mode
  discountPercent Float   @default(0) // Negotiated discount (%)
  vatPercent      Float   @default(20) // VAT rate (%)
  includeVat      Boolean @default(true) // Whether price inc VAT is quoted

  stages          Stage[]
  risks           Risk[]
  gostPackages    GostPackage[]
  internalChanges InternalChange[]
  // #103 WP-6a: журнал факта
  actualEntries   ActualEntry[]
  actualSyncRuns  ActualSyncRun[]
  taskMappings    ExternalTaskMapping[]
  // #103 WP-5e: явные зависимости этапов
  stageDependencies StageDependency[]

  // The calculation list is always sorted newest-first. `id` is part of the index
  // because it is the tie-breaker in the paged ordering: without it, rows sharing a
  // createdAt can swap places between two offset queries and appear twice or vanish.
  @@index([createdAt, id])
  @@index([templateId])
  // The architect screen splits the archive into "awaiting approval" and the rest.
  @@index([status, createdAt, id])
  @@index([projectId, version])
}

// Versioned released document package under GOST 34 standards (Horizon B1).
model GostPackage {
  id      String @id @default(cuid())
  name    String // Package title (e.g., "Комплект ТЗ и ПМИ v1.0")
  version Int    @default(1)
  status  String @default("draft") // draft | under_review | approved | rejected | archived
  // Момент последней смены status/reviewStage (см. Calculation.stageEnteredAt).
  stageEnteredAt DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  standardProfileId      String // ru-gost34-current | gost34-legacy-89 | custom
  standardProfileVersion String
  generatorVersion       String

  documentTypes String // JSON-encoded array of document types: ["tz", "pmi", "tp"]
  metadata      String? // JSON snapshot of wizard choices, profile overrides, checklist
  snapshot      String? // JSON snapshot of wizard state (requirements v2, links, applicability, signatures, overrides)
  artifactPath  String? // Relative path to saved immutable ZIP on storage volume
  checksum      String? // SHA-256 integrity hash of document definitions/artifacts

  releasedAt    DateTime?
  releasedBy    String?
  reviewComment String? // Review comment on approve/reject
  approvedAt    DateTime?
  approvedBy    String?

  // --- Двухэтапное ревью -------------------------------------------------
  // Этап 1 — нормоконтроль тех.писателя, этап 2 — финальное ревью ГАП.
  // Статус пакета проходит review_tw -> review_gap -> approved | rejected.
  // Хранится отдельно от `status`, чтобы отклонение на любом этапе не стирало
  // информацию о том, докуда комплект дошёл.
  reviewStage     String  @default("tw") // tw | gap | done
  /// Чек-лист нормоконтроля: JSON [{ id, state, note, checkedBy, checkedAt }].
  reviewChecklist String?
  /// Комментарии по разделам: JSON [{ id, sectionId, severity, text, author, createdAt }].
  reviewComments  String?

  // --- Версия тех.писателя -----------------------------------------------
  // Ревьювер скачивает комплект, правит DOCX и загружает обратно. Загруженная
  // версия становится приоритетной: выпуск берёт её, а не сгенерированную.
  twVersionPath       String?
  twVersionName       String?
  twVersionUploadedAt DateTime?
  twVersionUploadedBy String?
  twVersionIsPriority Boolean   @default(false)
  createdBy           String    @default("architect")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([projectId, version])
  @@index([calculationId])
  @@index([status, createdAt])

  // #103 WP-3a: back-relations для назначений и замечаний ревью
  reviewAssignments ReviewAssignment[]
  reviewCommentRows ReviewComment[]

  // #103 WP-4a: проверки приёмки конкретной редакции комплекта
  acceptanceChecks AcceptanceCheck[]
  // #103 WP-4b: решения приёмочной комиссии по редакции
  acceptanceDecisions AcceptanceDecision[]
}

// A stage on the Gantt chart. Approval tasks (auto-inserted whenever a stage's
// executor role requires customer sign-off) are Stage rows with isApprovalTask = true.
model Stage {
  id                 String            @id @default(cuid())
  calculationId      String
  calculation        Calculation       @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  name               String
  role               String
  hours              Float
  order              Int
  startDate          DateTime
  endDate            DateTime
  isApprovalTask     Boolean           @default(false)
  approvalForStageId String?
  status             String            @default("planned") // planned | in_progress | done | approved | rejected
  dueDate            DateTime?
  requirements       String? // "Требования и ограничения" for this specific stage
  // Architect-editable Gantt controls (primary stages only, not approval-task rows):
  parallel           Boolean           @default(false) // starts alongside the preceding non-parallel stage
  approvalDays       Int? // custom duration (business days) for this stage's own approval task; null = default 3
  // Факт по этапу выигранной версии (Horizon E1); null — факт не вносился.
  actualHours        Float?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  actualNote         String?
  // #103 4.5: подтверждённая оценка оставшейся работы, ч. null — не подтверждена
  // («неизвестно», а не 0). Пишется только через PATCH этапа; перестройка плана
  // это поле не трогает.
  remainingHoursEstimate Float?
  // Факт этапа в момент оценки: изменился — оценка устарела (прогноз неполный).
  remainingActualBaseline Float?
  remainingEstimatedBy   String?
  remainingEstimatedAt   DateTime?
  // #103 WP-6a: actualHours/даты факта — агрегат этих записей
  actualEntries      ActualEntry[]
  taskMappings       ExternalTaskMapping[]
  // Явные зависимости (#103 WP-5e): исходящие и входящие.
  dependentsOut      StageDependency[] @relation("StageDependencyFrom")
  dependenciesIn     StageDependency[] @relation("StageDependencyTo")
  createdAt          DateTime          @default(now())

  // Stages are only ever read as "all rows for one calculation, in Gantt order".
  @@index([calculationId, order])
  // Ресурсный план (E2) выбирает этапы по диапазону дат поверх всех расчётов.
  @@index([startDate])
}

// A risk the architect flags on a calculation, with the extra labor hours it adds
// to the total estimate. Risks aren't stages — no dates, no Gantt row.
model Risk {
  id            String      @id @default(cuid())
  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  description   String
  hours         Float       @default(0)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([calculationId, order])
}

// Append-only security / compliance trail (Horizon A).
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorType  String // user | share | system | anonymous
  actorId    String?
  action     String // e.g. calculation.create, calculation.export.pdf
  entityType String?
  entityId   String?
  meta       String? // JSON
  ip         String?

  @@index([at])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action, at])
}

/// Лист внутренних изменений: сквозной журнал правок комплекта и расчёта.
///
/// Отличается от AuditEvent назначением: аудит пишет технические события для
/// расследования, а этот лист — документ, который выгружается заказчику в
/// .xlsx и отдельным файлом кладётся в комплект. Поэтому у записи есть
/// человекочитаемые «документ · раздел» и «изменение», а не JSON-мета.
model InternalChange {
  id String @id @default(cuid())

  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  /// Порядковый номер в листе, 1-based. В UI печатается как «И-01»:
  /// нумерация сквозная в пределах расчёта и не переиспользуется.
  seq Int

  occurredAt DateTime @default(now())
  author     String
  /// Роль автора на момент правки — она может смениться, а лист неизменяем.
  role       String

  /// «ТЗ · п. 4.2.1», «Расчёт · этапы», «Комплект · v3».
  docRef String
  text   String

  /// Что породило запись: upload | tw-edit | studio-inline | calculation | release | review
  source String

  /// Пакет, к которому относится правка, если она пришла из ревью или выпуска.
  packageId String?

  createdAt DateTime @default(now())

  @@unique([calculationId, seq])
  @@index([calculationId, occurredAt])
}

// Ёмкость ролей для ресурсного плана (Horizon E2). Одна строка — одна роль с
// датой начала действия: история хранится, чтобы прошлые недели не
// пересчитывались задним числом при изменении штата.
model RoleCapacity {
  id            String   @id @default(cuid())
  role          String // canonical Role из lib/roles.ts
  headcount     Float // ставок (1.5 = полтора человека)
  hoursPerWeek  Float    @default(30) // продуктивных часов на ставку
  effectiveFrom DateTime
  note          String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([role, effectiveFrom])
}

// Сохранённый срез конструктора отчётов по отклонениям (Horizon E3):
// набор задач, фильтры, группировка и метрика в JSON.
model DeviationReport {
  id        String   @id @default(cuid())
  name      String
  config    String // JSON DeviationReportConfig
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy, updatedAt])
}

// Append-only project BOM. Each revision stores its own complete snapshot.
// Catalogue updates must never modify these rows.
model SpecificationVersion {
  id            String      @id @default(cuid())
  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  version       Int
  status        String      @default("draft")
  data          String
  createdBy     String
  createdAt     DateTime    @default(now())

  @@unique([calculationId, version])
}

// Technical identity is independent from price offers and project snapshots.
model CatalogVendor {
  id             String                 @id @default(cuid())
  name           String
  revision       Int                    @default(1)
  archived       Boolean                @default(false)
  createdBy      String
  createdAt      DateTime               @default(now())
  products       CatalogProduct[]
  imports        CatalogImport[]
  importProfiles CatalogImportProfile[]
}

model CatalogProduct {
  id         String         @id @default(cuid())
  vendorId   String
  vendor     CatalogVendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  revision   Int            @default(1)
  archived   Boolean        @default(false)
  name       String
  sku        String
  edition    String
  kind       String
  unit       String
  licensing  String
  attributes Json
  createdBy  String
  createdAt  DateTime       @default(now())
  offers     CatalogOffer[]

  @@index([vendorId, archived])
}

// Append-only offers; missing price/dates have no implied value or validity.
model CatalogOffer {
  id                 String         @id @default(cuid())
  productId          String
  productRevision    Int
  importProvenance   Json? // Original attachment, sheet and row identity.
  productSnapshot    Json? // Immutable technical identity at offer creation; null marks legacy unknown.
  product            CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  source             String
  unitPrice          Decimal?       @db.Decimal(18, 6)
  currency           String
  region             String
  terms              String
  priceDate          String?
  validUntil         String?
  taxRate            Decimal?       @db.Decimal(7, 4) // Percent; null is unknown, not 0.
  taxExempt          Boolean        @default(false) // Explicit «Без НДС», distinct from unknown.
  discountCategory   String         @default("")
  // unconfirmed | confirmed. GPL offers are confirmed only by the explicit import confirmation.
  confirmationStatus String         @default("unconfirmed")
  confirmedBy        String?
  confirmedAt        DateTime?
  createdBy          String
  createdAt          DateTime       @default(now())

  @@index([productId, createdAt])
}

// Original attachment and identity retained; analysis revisions are append-only.
model CatalogImport {
  id          String                  @id @default(cuid())
  vendor      CatalogVendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorId    String
  filename    String
  checksum    String
  file        Bytes
  revision    Int                     @default(1)
  status      String                  @default("draft")
  createdBy   String
  createdAt   DateTime                @default(now())
  confirmedBy String?
  confirmedAt DateTime?
  revisions   CatalogImportRevision[]

  @@unique([vendorId, checksum])
}

model CatalogImportRevision {
  id        String        @id @default(cuid())
  importId  String
  batch     CatalogImport @relation(fields: [importId], references: [id], onDelete: Restrict)
  revision  Int
  data      Json
  createdBy String
  createdAt DateTime      @default(now())

  @@unique([importId, revision])
}

// ==== #103 WP-5d: work calendars ====
// Производственный календарь: выходные дни недели + исключения (праздники,
// рабочие выходные, сокращённые дни). Ровно один календарь — по умолчанию
// (частичный уникальный индекс в миграции). Один и тот же календарь читают
// Гант (lib/scheduling.ts) и ресурсный план (lib/capacity.ts) через lib/calendar.ts.
model WorkCalendar {
  id          String              @id @default(cuid())
  name        String
  isDefault   Boolean             @default(false)
  // ISO-дни недели через запятую (1 = пн … 7 = вс), по умолчанию сб и вс.
  weekendDays String              @default("6,7")
  note        String?
  createdBy   String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  exceptions  CalendarException[]
  templates   FormTemplate[]
}

model CalendarException {
  id         String       @id @default(cuid())
  calendar   WorkCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  calendarId String
  date       DateTime     @db.Date
  kind       String // holiday | workday | short (CHECK в миграции)
  // Для short: длительность дня в часах стандартного 8-часового дня (по умолчанию 7).
  hours      Float?
  note       String?
  createdBy  String
  createdAt  DateTime     @default(now())

  @@unique([calendarId, date])
}

// Резерв ёмкости роли (отпуска, пресейл, внутренние работы): уменьшает
// ёмкость в ресурсном плане на hoursPerWeek в неделях интервала [from, to].
model RoleReservation {
  id           String   @id @default(cuid())
  role         String // canonical Role из lib/roles.ts
  from         DateTime @db.Date
  to           DateTime @db.Date
  hoursPerWeek Float
  reason       String
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([role, from])
}

// ==== #103 WP-3a: review assignments ====

// Персональный ответственный за этап ревью комплекта. Назначение не даёт права
// подписи: решение на этапе по-прежнему закреплено за ролью (REVIEW_STAGE_ROLES).
// Активное назначение на пару (комплект, этап) одно — частичный уникальный
// индекс "ReviewAssignment_active_key" создан SQL-миграцией (WHERE "active").
model ReviewAssignment {
  id         String      @id @default(cuid())
  packageId  String
  package    GostPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  stage      String // tw | gap
  // User.id без @relation: удаление пользователя не должно стирать историю.
  assigneeId String
  deputyId   String?
  dueAt      DateTime
  assignedBy String
  assignedAt DateTime    @default(now())
  active     Boolean     @default(true)

  @@index([packageId, stage])
  @@index([assigneeId, active])
  @@index([deputyId, active])
}

// Замечание ревью с жизненным циклом open -> fixed -> verified | rejected.
// Заменяет JSON GostPackage.reviewComments (тот остаётся резервом только для чтения).
model ReviewComment {
  id               String               @id @default(cuid())
  packageId        String
  package          GostPackage          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  stage            String // tw | gap — этап, на котором оставлено замечание
  sectionId        String
  severity         String // blocker | remark | suggestion
  text             String
  author           String
  authorId         String?
  createdAt        DateTime             @default(now())
  status           String               @default("open") // open | fixed | verified | rejected
  fixedBy          String?
  fixedAt          DateTime?
  // Более новая версия комплекта той же линии, где замечание исправлено.
  fixedInPackageId String?
  fixedInVersion   Int?
  verifiedBy       String?
  verifiedAt       DateTime?
  // Перенесено из JSON-столбца миграцией: такие замечания действуют только в
  // своём комплекте и в новые версии не переходят.
  legacy           Boolean              @default(false)
  replies          ReviewCommentReply[]

  @@index([packageId, status])
  @@index([fixedInPackageId])
}

model ReviewCommentReply {
  id        String        @id @default(cuid())
  commentId String
  comment   ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  text      String
  author    String
  authorId  String?
  createdAt DateTime      @default(now())

  @@index([commentId, createdAt])
}

// ==== #103 WP-6a: actuals ledger ====
// Журнал факта: каждая запись — часы из одного источника (csv, manual, трекер).
// Stage.actualHours и даты факта — агрегат неудалённых записей (lib/actualsLedger.ts).
// source — TEXT с CHECK: 'csv' | 'manual' | идентификатор трекера ([a-z][a-z0-9_-]*).
model ActualEntry {
  id                String      @id @default(cuid())
  calculationId     String
  calculation       Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  stageId           String?
  stage             Stage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)
  source            String
  externalId        String
  externalTaskKey   String?
  author            String?
  /// null — запись несёт только даты (ручная правка дат без часов).
  hours             Float?
  startDate         DateTime?
  endDate           DateTime?
  externalUpdatedAt DateTime?
  /// Для ручной поправки (externalId adj:<stageId>): источники через запятую,
  /// относительно которых она посчитана.
  basis             String?
  syncedAt          DateTime    @default(now())
  /// Мягкое удаление: запись пропала из полной синхронизации или факт очищен вручную.
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([calculationId, source, externalId])
  @@index([stageId])
}

// Журнал прогонов синхронизации (CSV или трекер): кто, когда, сколько и с какими ошибками.
model ActualSyncRun {
  id            String      @id @default(cuid())
  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  source        String
  mode          String      @default("incremental") // incremental | full
  startedBy     String?
  cursor        String?
  /// Режим ручных часов импорта: auto | replace | add (null — не применялся).
  manualHours   String?
  created       Int         @default(0)
  updated       Int         @default(0)
  unchanged     Int         @default(0)
  deleted       Int         @default(0)
  skipped       Int         @default(0)
  errors        Json        @default("[]")
  createdAt     DateTime    @default(now())

  @@index([calculationId, source, createdAt])
}

// Сопоставление внешней задачи (ключ трекера или задачи в CSV) с этапом расчёта.
model ExternalTaskMapping {
  id              String      @id @default(cuid())
  calculationId   String
  calculation     Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  source          String
  externalTaskKey String
  stageId         String
  stage           Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([calculationId, source, externalTaskKey])
}

// Reusable column mapping per vendor/format. Applying it to a new file matches
// columns by header name; mismatches are reported, never silently guessed.
model CatalogImportProfile {
  id        String        @id @default(cuid())
  vendor    CatalogVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorId  String
  name      String
  format    String // csv | xlsx
  profile   Json
  revision  Int           @default(1)
  archived  Boolean       @default(false)
  createdBy String
  createdAt DateTime      @default(now())
  updatedBy String
  updatedAt DateTime      @default(now())

  // Name is unique among non-archived profiles only (partial unique index in the migration).
  @@index([vendorId, format, name])
}

// ==== #103 WP-2a: change requests ====
// Запрос на изменение требований. Ссылки на проект, базовый расчёт и комплект —
// скалярные id без @relation: общие модели не меняются, а запрос не должен
// каскадно править договорную базу. Пока запрос не принят, базовые расчёт,
// этапы и комплект остаются нетронутыми; новая версия создаётся только
// решением «принять» (следующий этап WP-2b) и записывается в result*Id.
model ChangeRequest {
  id                    String               @id @default(cuid())
  projectId             String
  // Сквозной номер в пределах проекта, печатается как «ЗИ-01».
  seq                   Int
  title                 String
  initiator             String
  reason                String
  status                String               @default("draft") // draft | submitted | accepted | rejected | deferred (CHECK в миграции)
  baseCalculationId     String
  basePackageId         String?
  // Снимок затронутых требований базового комплекта: [{ id, code, text }].
  affectedRequirements  Json                 @default("[]")
  // Предлагаемые изменения: { summary, items: [{ kind, requirementId, text }] }.
  proposedChanges       Json                 @default("{}")
  // Связанные этапы/документы/проверки (lib/changeRequests/impact.ts). Часы
  // этапов — справочно, сумма не считается.
  impact                Json?
  // Оценка специалиста: вводится явно, все три значения вместе.
  confirmedHours        Float?
  confirmedCost         Decimal?             @db.Decimal(18, 2)
  confirmedScheduleDays Int?
  estimateComment       String?
  estimatedBy           String?
  estimatedAt           DateTime?
  // Решение и результат (WP-2b): кто решил и какие версии появились.
  decidedBy             String?
  decidedAt             DateTime?
  resultCalculationId   String?
  resultPackageId       String?
  createdBy             String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  events                ChangeRequestEvent[]

  @@unique([projectId, seq])
  @@index([projectId, status])
  @@index([baseCalculationId])
}

// Журнал согласования запроса: только добавление, записи не правятся.
model ChangeRequestEvent {
  id            String        @id @default(cuid())
  changeRequest ChangeRequest @relation(fields: [crId], references: [id], onDelete: Cascade)
  crId          String
  action        String // created | updated | submitted | estimated | accepted | rejected | deferred | reopened (CHECK в миграции)
  actor         String
  comment       String?
  // Значения на момент события (например, оценка), чтобы переоценка не стирала историю.
  data          Json?
  at            DateTime      @default(now())

  @@index([crId, at])
}

// ==== #103 WP-4a: acceptance checks ====
// Проверка приёмки — требование конкретной утверждённой редакции комплекта,
// у которого в снимке есть критерий приёмки или метод проверки. Результаты
// только дописываются (UPDATE запрещён триггером): текущее состояние — это
// последний результат, а без результатов проверка «не проводилась».
model AcceptanceCheck {
  id              String             @id @default(cuid())
  packageId       String
  package         GostPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Денормализовано из комплекта для выборок по расчёту; источник истины — packageId.
  calculationId   String
  requirementId   String
  requirementCode String
  title           String
  method          String? // INSPECTION | ANALYSIS | DEMONSTRATION | TEST
  criteria        String[]
  order           Int
  createdBy       String
  createdAt       DateTime           @default(now())
  results         AcceptanceResult[]
  remarks         AcceptanceRemark[]
  evidence        AcceptanceEvidence[]

  @@unique([packageId, requirementId])
  @@index([calculationId])
}

model AcceptanceResult {
  id           String          @id @default(cuid())
  checkId      String
  check        AcceptanceCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  status       String // not_run | passed | failed | blocked
  executorName String?
  executorId   String?
  executedAt   DateTime?
  actualResult String?
  /// Снимок вложений на момент записи: [{ id, key, name, size, mime, checksum, uploadedAt, uploadedBy }].
  /// Источник истины — AcceptanceEvidence (загрузчик и время фиксируются при загрузке).
  evidence     Json            @default("[]")
  recordedBy   String
  createdAt    DateTime        @default(now())

  remarks       AcceptanceRemark[] @relation("AcceptanceRemarkResult")
  retestRemarks AcceptanceRemark[] @relation("AcceptanceRemarkRetest")
  attachments   AcceptanceEvidence[]

  @@index([checkId, createdAt])
}

model AcceptanceRemark {
  id             String            @id @default(cuid())
  checkId        String
  check          AcceptanceCheck   @relation(fields: [checkId], references: [id], onDelete: Cascade)
  resultId       String?
  result         AcceptanceResult? @relation("AcceptanceRemarkResult", fields: [resultId], references: [id], onDelete: SetNull)
  text           String
  status         String            @default("open") // open | resolved | verified
  retestResultId String?
  retestResult   AcceptanceResult? @relation("AcceptanceRemarkRetest", fields: [retestResultId], references: [id], onDelete: SetNull)
  createdBy      String
  // User.id автора: править текст вправе только автор или администратор.
  createdById    String?
  createdAt      DateTime          @default(now())
  resolvedBy     String?
  resolvedAt     DateTime?
  verifiedBy     String?
  verifiedAt     DateTime?
  edits          AcceptanceRemarkEdit[]

  @@index([checkId, status])
}

// Журнал правок текста замечания: прежний и новый текст, кто и когда.
model AcceptanceRemarkEdit {
  id           String           @id @default(cuid())
  remarkId     String
  remark       AcceptanceRemark @relation(fields: [remarkId], references: [id], onDelete: Cascade)
  previousText String
  newText      String
  editedBy     String
  editedById   String
  editedAt     DateTime         @default(now())

  @@index([remarkId, editedAt])
}

// Вложение проверки. Загрузчик и время фиксирует сервер при загрузке; до
// записи результата вложение не прикреплено (resultId = null) и может быть
// удалено загрузчиком. Неприкреплённые вложения старше суток удаляются при
// следующей загрузке к той же проверке (см. docs/acceptance.md).
model AcceptanceEvidence {
  id           String            @id @default(cuid())
  checkId      String
  check        AcceptanceCheck   @relation(fields: [checkId], references: [id], onDelete: Cascade)
  resultId     String?
  result       AcceptanceResult? @relation(fields: [resultId], references: [id], onDelete: Cascade)
  key          String            @unique
  name         String
  size         Int
  mime         String
  checksum     String
  uploadedBy   String
  uploadedById String
  uploadedAt   DateTime          @default(now())

  @@index([checkId, resultId])
}

// ==== #103 WP-6c: norm proposals ====

// Предложение изменить норматив этапа шаблона (baseHours/hoursPerUnit) по
// факту завершённых проектов. Утверждает владелец шаблона (admin): меняется
// только StageTemplate, уже созданные расчёты не трогаются. Правила —
// docs/norm-proposals.md, расчёт — lib/normProposals.ts. Не больше одного
// открытого предложения на этап шаблона (частичный уникальный индекс в миграции).
model NormProposal {
  id                   String        @id @default(cuid())
  stageTemplateId      String
  stageTemplate        StageTemplate @relation(fields: [stageTemplateId], references: [id], onDelete: Cascade)
  formTemplateId       String
  formTemplate         FormTemplate  @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  /// Снимок этапа на момент формирования: утверждение отклоняется (409), если
  /// изменились имя, роль, драйвер или норматив.
  currentStageName      String
  currentStageRole      String
  currentDriverFieldKey String?
  currentBaseHours     Float
  currentHoursPerUnit  Float
  proposedBaseHours    Float
  proposedHoursPerUnit Float
  /// Сколько полных наблюдений вошло в статистику (без выбросов).
  sampleSize           Int
  /// Доля завершённых этапов выборки с внесённым фактом, 0..1.
  completeness         Float
  confidence           String // low | medium | high
  /// Метод, пороги, использованные расчёты (id, план, формула, факт), выбросы.
  explanation          Json
  /// Отпечаток входных данных: повторная генерация с теми же данными не плодит записи.
  fingerprint          String
  status               String        @default("proposed") // proposed | approved | rejected | superseded
  createdBy            String?
  createdAt            DateTime      @default(now())
  decidedBy            String?
  decidedAt            DateTime?
  decisionComment      String?

  @@index([formTemplateId, status, createdAt])
  @@index([stageTemplateId, status])
}

// ==== #103 WP-5e: stage dependencies ====
// Явная зависимость этапов расчёта: этап toStage начинается после fromStage.
// Тип — TEXT с CHECK (пока только 'FS' — окончание → начало), чтобы позже
// добавить SS/FF без смены типа колонки. lagDays — пауза в рабочих днях по
// производственному календарю. Петли и дубли запрещены в БД, циклы — в API
// (lib/scheduling.ts validateDependencies). Перестройка этапов (rebuildStages)
// переносит зависимости на пересозданные строки.
model StageDependency {
  id            String      @id @default(cuid())
  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  fromStageId   String
  fromStage     Stage       @relation("StageDependencyFrom", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStageId     String
  toStage       Stage       @relation("StageDependencyTo", fields: [toStageId], references: [id], onDelete: Cascade)
  type          String      @default("FS")
  lagDays       Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([fromStageId, toStageId])
  @@index([calculationId])
  @@index([toStageId])
}

// Сохранённое сравнение вариантов ресурсного плана (сдвиг старта, подрядчик,
// изменение команды). Только для истории и обсуждения: никогда не применяется
// автоматически — даты меняет только /api/capacity/apply.
model PlanScenario {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  variants  Json
  result    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ==== #101 WP5: sizing ====
// Сайзинг — техническая потребность (CPU/RAM/диски/EPS/поток/узлы/лицензии),
// отдельная от закупаемых SKU спецификации. Профиль версионируется: утвержденная
// версия неизменяема (триггер в миграции), прогон закрепляет версию и хранит
// рассчитанные результаты, поэтому новая версия не меняет старые прогоны.
model SizingProfile {
  id          String                 @id @default(cuid())
  key         String                 @unique
  name        String
  domain      String
  description String                 @default("")
  archived    Boolean                @default(false)
  createdBy   String
  createdAt   DateTime               @default(now())
  versions    SizingProfileVersion[]
}

model SizingProfileVersion {
  id          String        @id @default(cuid())
  profileId   String
  profile     SizingProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  version     Int
  // Декларативные правила: входы, производные формулы, метрики, сценарии, таблицы.
  rules       Json
  // Допущения профиля (string[]), показываются вместе с результатом.
  assumptions Json
  source      String
  status      String        @default("draft") // draft | approved | archived (CHECK в миграции)
  createdBy   String
  createdAt   DateTime      @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  runs        SizingRun[]

  @@unique([profileId, version])
}

// Прогон только добавляется (UPDATE и прямой DELETE запрещены триггером; удаление —
// только каскадом с расчетом). source=manual — ручной
// сайзинг без профиля: outputs введены пользователем.
model SizingRun {
  id               String                @id @default(cuid())
  calculationId    String
  calculation      Calculation           @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  profileVersionId String?
  profileVersion   SizingProfileVersion? @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  source           String // profile | manual (CHECK в миграции)
  inputs           Json
  scenarios        Json
  outputs          Json
  note             String                @default("")
  createdBy        String
  createdAt        DateTime              @default(now())

  @@index([calculationId, createdAt])
  @@index([profileVersionId])
}

// ==== #103 WP-4b: acceptance decision ====
// Решение приёмочной комиссии по утверждённой редакции комплекта. Решения
// только дописываются (UPDATE запрещён триггером): действующее — последнее;
// если после него записаны новые результаты проверок, оно устарело и в акт
// не попадает. checksSnapshot фиксирует, по каким фактам принято решение.
model AcceptanceDecision {
  id             String      @id @default(cuid())
  packageId      String
  package        GostPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  decision       String // accepted | accepted_with_remarks | rejected
  /// Состав комиссии: [{ name, position?, organization? }].
  commission     Json
  basis          String
  /// Для accepted_with_remarks: [{ checkId, requirementCode, note }].
  exceptions     Json        @default("[]")
  /// Факты на момент решения: [{ checkId, requirementCode, status, resultId, openRemarks, needsReview }].
  checksSnapshot Json
  decidedBy      String
  decidedById    String
  decidedAt      DateTime    @default(now())

  @@index([packageId, decidedAt])
}

// ==== #103 WP-3b: notifications ====

// Уведомление внутри приложения (почты нет: у User нет адреса). Получатель —
// User.id без @relation, как ReviewAssignment.assigneeId: удаление пользователя
// не стирает историю. Уведомление ничего не разрешает — право решения
// по-прежнему выдаёт только роль этапа.
// Уникальность (userId, kind, entityId, dueAt) делает просрочку идемпотентной:
// у прочих видов dueAt пуст, а NULL в Postgres с NULL не совпадает, поэтому
// повторные ответы в одной ветке не схлопываются.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  kind       String // assigned | deputy_assigned | returned | overdue | comment_reply | comment_fixed | comment_verified | comment_rejected | comment_reopened
  entityType String // gost_package | review_assignment | review_comment
  entityId   String
  payload    Json?
  dueAt      DateTime?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@unique([userId, kind, entityId, dueAt])
  @@index([userId, readAt])
}
