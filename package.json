{
  "name": "evacal",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results.xml",
    "test:watch": "vitest",
    "test:golden:update": "tsx lib/gost34/__tests__/golden/update.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-projects": "tsx scripts/backfill-projects.ts",
    "format": "prettier --write .",
    "prepare": "if [ -z \"$CI\" ]; then npm run format && npm run typecheck; fi"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/jszip": "^3.4.0",
    "bcryptjs": "^2.4.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "next": "15.5.21",
    "pdfkit": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "husky": "^9.0.0",
    "postcss": "^8.5.18",
    "prettier": "^3.2.5",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7",
    "xml-js": "^1.6.11"
  },
  "overrides": {
    "postcss": {
      ".": "^8.5.18",
      "nanoid": "^3.3.8"
    },
    "sharp": "^0.35.3",
    "docx": {
      "nanoid": "^5.0.9"
    },
    "next": {
      "sharp": "^0.35.3"
    }
  }
}
