# СУБД: PostgreSQL (основная; в Docker поднимается сервисом `postgres`) или
# встраиваемый SQLite для одного стенда. Провайдер выводится из схемы URL
# (postgresql: / file:), DATABASE_PROVIDER нужен только там, где клиент Prisma
# генерируется до того, как известен URL (сборка Docker-образа, CI).
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://evacal:secret@localhost:5432/evacal?schema=public"
# Пароль сервиса `postgres` в docker compose (DATABASE_URL для контейнеров
# собирается из него автоматически, если не задан явно)
POSTGRES_PASSWORD="secret"
# SQLite вместо PostgreSQL:
# DATABASE_PROVIDER=sqlite
# DATABASE_URL="file:./prisma/dev.db"
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"
# --- Хранилище артефактов комплектов ГОСТ 34 (ZIP выпуска, DOCX тех.писателя) ---
# По умолчанию файлы: GOST_PACKAGE_STORAGE_PATH (storage/gost-packages; в Docker — том
# storage-data). Для нескольких реплик и централизованных бэкапов — S3-совместимое
# хранилище (AWS S3, MinIO, Yandex/VK Object Storage, Ceph RGW): достаточно S3_BUCKET.
# GOST_PACKAGE_STORAGE=s3            # fs | s3; без явного значения — s3, если задан S3_BUCKET
# S3_BUCKET="evacal-artifacts"
# S3_ENDPOINT="http://minio:9000"    # пусто — AWS S3
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="evacal"          # пусто — стандартная цепочка AWS (IAM-роль, AWS_* env)
# S3_SECRET_ACCESS_KEY="change-me"
# S3_FORCE_PATH_STYLE=true           # по умолчанию true при своём endpoint
# S3_PREFIX="prod"                   # префикс ключей внутри бакета
# Бакет должен существовать заранее (docker compose --profile minio: создать в консоли
# http://127.0.0.1:9001 или `mc mb`).

# Optional dedicated HMAC secret for share tokens (falls back to SESSION_SECRET).
# SHARE_TOKEN_SECRET=""

# Только для локального стенда: один фиксированный пароль на все 4 учётки при первом сиде
# (по умолчанию каждой генерируется свой случайный). В прод-окружении не задавать.
# SEED_DEFAULT_PASSWORD=""

# Legacy open data-plane for local demos only. NEVER enable in production.
# When false/unset: calculations list/export/submit require staff login or ?share= token.
# ALLOW_ANONYMOUS_PRESALE=false

# Force Secure cookies even outside NODE_ENV=production (behind TLS reverse proxy).
# FORCE_SECURE_COOKIES=true

# --- LLM-провайдеры для ИИ-нормализации требований ГОСТ 34 ---
# Адреса и ключи задаются ТОЛЬКО здесь: клиент выбирает провайдера по id и
# никогда не передаёт URL или ключ на сервер.

# Адреса локальных моделей (используются встроенными провайдерами)
# OLLAMA_HOST="http://localhost:11434"
# LMSTUDIO_HOST="http://localhost:1234/v1"

# Убрать встроенные локальные провайдеры (например, в SaaS-развёртывании)
# EVACAL_LLM_DISABLE_LOCAL=1

# Дополнительные провайдеры: JSON-массив
# {id,label,kind:"ollama"|"openai_compatible",endpoint,apiKeyEnv?,defaultModel?}
# Ключ хранится в отдельной переменной, имя которой указано в apiKeyEnv.
# EVACAL_LLM_PROVIDERS='[{"id":"corp","label":"Corp LLM","kind":"openai_compatible","endpoint":"https://llm.example.com/v1","apiKeyEnv":"CORP_LLM_KEY"}]'
# CORP_LLM_KEY="..."

# Провайдер по умолчанию (иначе — первый в списке)
# EVACAL_LLM_DEFAULT_PROVIDER="local-ollama"

# Политика адресов. Loopback разрешён по умолчанию (локальные модели),
# внутренняя сеть — нет. Link-local (169.254.0.0/16, fe80::/10) запрещён всегда.
# EVACAL_LLM_ALLOW_LOOPBACK=true
# EVACAL_LLM_ALLOW_PRIVATE_NETWORK=false
