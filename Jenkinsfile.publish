// Manual publisher; GitHub Actions remains opt-in to avoid consuming runner minutes.
pipeline {
  agent any
  parameters {
    string(name: 'REF', defaultValue: '', description: 'Existing release tag (vX.Y.Z) or branch (main). Required.')
    string(name: 'SOURCE_URL', defaultValue: 'https://github.com/onixus/EvaCal.git', description: 'Git URL, or a local mirror path available to this agent.')
    booleanParam(name: 'DRY_RUN', defaultValue: true, description: 'Build both targets without login, push or release promotion.')
    booleanParam(name: 'MULTIARCH', defaultValue: true, description: 'linux/amd64 + linux/arm64; otherwise the native agent architecture.')
  }
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 90, unit: 'MINUTES')
  }
  environment {
    EVACAL_PUBLISH_IMAGE = 'ghcr.io/onixus/evacal'
  }
  stages {
    stage('Checkout ref') {
      steps {
        script { if (!params.REF?.trim()) { error('REF is required: release tag or branch') } }
        checkout([
          $class: 'GitSCM',
          branches: [[name: params.REF]],
          userRemoteConfigs: [[url: params.SOURCE_URL, refspec: '+refs/heads/*:refs/remotes/origin/* +refs/tags/*:refs/tags/*']],
        ])
        sh 'git --no-pager log --oneline -1'
      }
    }
    stage('Login') {
      when { expression { !params.DRY_RUN } }
      steps {
        withCredentials([
          string(credentialsId: 'GHCR_USER', variable: 'GHCR_USER'),
          string(credentialsId: 'GHCR_TOKEN', variable: 'GHCR_TOKEN'),
        ]) {
          sh '''
            set -eu
            printf '%s' "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin
          '''
        }
      }
    }
    stage('Test, build both images, smoke, promote, package') {
      steps {
        withEnv(["REF=${params.REF}", "DRY_RUN=${params.DRY_RUN}", "MULTIARCH=${params.MULTIARCH}"]) {
          sh 'bash scripts/docker-publish.sh'
        }
      }
    }
  }
  post {
    success {
      script { if (!params.DRY_RUN) { archiveArtifacts artifacts: 'dist/*-deploy.tar.gz*', fingerprint: true } }
    }
    always {
      script { if (!params.DRY_RUN) { sh 'docker logout ghcr.io || true' } }
    }
  }
}
